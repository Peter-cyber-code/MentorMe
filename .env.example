# Copier en .env (jamais commité) et adapter.

# --- Django ---------------------------------------------------------------
# Production : DJANGO_DEBUG=0 (valeur par défaut si absent)
DJANGO_DEBUG=1
# Générer : python -c "import secrets;print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines Flutter Web autorisées (séparées par des virgules) ; inutile en mobile
CORS_ALLOWED_ORIGINS=http://localhost:5000
# Derrière un proxy qui termine déjà le TLS et redirige : DJANGO_SECURE_SSL_REDIRECT=0
# DJANGO_SECURE_SSL_REDIRECT=1

# --- Base de données (PostgreSQL) ----------------------------------------
# En DEBUG, si absent : SQLite locale. Hors DEBUG : obligatoire.
DATABASE_URL=postgres://mentorme:mentorme@localhost:5432/mentorme

# --- Redis (cache de throttling + WebSocket) -----------------------------
# En DEBUG, si absent : mémoire locale. Hors DEBUG : obligatoire.
REDIS_URL=redis://localhost:6379/0

# --- IA -------------------------------------------------------------------
# mock (dev, gratuit) ou openai
AUDIT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Limites de débit (facultatif) ---------------------------------------
# THROTTLE_AUTH=10/min
# THROTTLE_AI_AUDIT=5/hour
